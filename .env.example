APP_NAME="Coachwood Marketing"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Production: LOG_STACK=daily and LOG_LEVEL=info.
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coachwood_marketing
DB_USERNAME=coachwood
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# The proxies whose X-Forwarded-For is believed (nginx on the same server).
# TRUSTED_PROXIES=127.0.0.1,::1
# How long browsers use HTTPS only, in seconds (0 turns it off).
# HSTS_SECONDS=31536000

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Heavy jobs (video assembly, catalogue syncs) have their own worker.
QUEUE_LONG_CONNECTION=redis-long

CACHE_STORE=redis
# Shares the Redis server with the CS app, so each app keeps its own prefix.
CACHE_PREFIX=coachwood_marketing
REDIS_PREFIX=coachwood_marketing_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# gmail_api in production (Settings → Email); log locally writes emails to storage/logs.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Generated files live in DigitalOcean Spaces (S3-compatible), not on the server disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=tor1
AWS_BUCKET=
AWS_ENDPOINT=https://tor1.digitaloceanspaces.com
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Provider keys are connections in the app (Connections page), not here. These
# are only for local checks of a provider's API before its plugin exists.
# HIGGSFIELD_API_KEY_ID=
# HIGGSFIELD_API_KEY_SECRET=
